# Dependencies in any directory
node_modules/

# Environment variables and secrets in any directory
.env
.env.*

# Safe templates may be committed; never put real secrets in these files
!.env.example
!.env.sample

# Ticket data contains raw ticket text; never commit it
# backend/storage 放 SQLite 資料庫（含 -wal／-shm）、舊版 tickets.json、還原保留檔、還原暫存檔與匯出的 JSON，只保留空目錄
backend/storage/*
!backend/storage/.gitkeep

# Local system files, logs, and private credentials
.DS_Store
*.log
*.log.*
.aws/
.npmrc
*.pem
*.key
*.p12
*.pfx
coverage/

# Docker 備份含工作單原文；image 匯出檔不進 Git
backups/
helpdesk-images*.tar
