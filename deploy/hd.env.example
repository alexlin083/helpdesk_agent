# deploy/hd 的連線設定範本：複製成 deploy/hd.env（不進 Git）後填入自己的值。
#   cp deploy/hd.env.example deploy/hd.env
# 這裡只放連線資訊，不放任何密碼或 API 金鑰；正式站的 .env 只存在 Lightsail 主機上。

# Lightsail 的固定 IP（Static IP）或網域
HD_HOST=填入實際的StaticIPv4

# SSH 私鑰的路徑（權限必須是 600：chmod 600 <路徑>）；私鑰不要放進專案資料夾
HD_SSH_KEY=~/.ssh/helpdesk-lightsail.pem

# SSH 使用者，Lightsail Ubuntu 預設是 ubuntu
HD_USER=ubuntu

# 主機上的部署目錄（相對於使用者家目錄），裡面要有 compose.yaml 與 .env
HD_REMOTE_DIR=helpdesk_agent

# 主機上保留幾個版本的 image（目前執行中與 prod-rb 一定保留）；每個版本約 130 MB
HD_KEEP_VERSIONS=5
