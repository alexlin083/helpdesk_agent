# NODE_ENV 由 shell / AWS 平台設定；本機預設 development。
PORT=3000
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# debug 顯示快取、請求參數與回應中繼資料；不輸出問題、文件或金鑰。
LOG_LEVEL=info

# 十組課堂帳號 admin1～admin10 共用密碼（僅在後端設定）。
DEMO_PASSWORD=123456
# 本機留空時使用暫時隨機值；production 必填至少 32 bytes 的隨機字串。
AUTH_SECRET=
AUTH_TTL_SECONDS=7200
CHAT_COOLDOWN_SECONDS=10
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
GLOBAL_CONCURRENCY=2
LOGIN_FAILURE_LIMIT=10
LOGIN_WINDOW_SECONDS=900
# 本機用 memory；production 強制要求 dynamodb 與下列 table、region。
LIMIT_STORE=memory
LIMIT_TABLE=
AWS_REGION=
# 本機留空。上雲後依實際代理鏈指定 IP／網段或 hop 數，勿直接信任所有代理。
TRUST_PROXY=
