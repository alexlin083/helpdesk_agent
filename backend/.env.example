# NODE_ENV 由 shell / AWS 平台設定；只接受 local（本機預設）或 production（正式環境）。
PORT=3000
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# debug 顯示請求參數與回應中繼資料；不輸出需求單原文或金鑰。
LOG_LEVEL=info
# 關機最多等待既有需求單處理（判斷逾時 15 秒）與租約清理的毫秒數，至少 25000。
SHUTDOWN_TIMEOUT_MS=75000

# 必填：一般課堂帳號的共用密碼，私下提供，不要填入此範本或提交 Git。
DEMO_PASSWORD=
# 必填：應用程式管理員 alex.admin 的獨立密碼，不得與 DEMO_PASSWORD 相同；不是 AWS IAM 密碼。
ADMIN_PASSWORD=
# 本機留空時使用暫時隨機值；production 必填至少 32 bytes 的隨機字串。
AUTH_SECRET=
AUTH_TTL_SECONDS=7200
CHAT_COOLDOWN_SECONDS=10
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
GLOBAL_CONCURRENCY=2
# HTTP 層限制，與需求單冷卻／每日額度分開；每個 middleware 各自計數。
HTTP_RATE_WINDOW_SECONDS=60
HTTP_RATE_MAX_KEYS=2048
HTTP_API_LIMIT=300
HTTP_LOGIN_LIMIT=120
HTTP_TICKET_LIMIT=12
HTTP_DEPARTMENTS_LIMIT=30
HTTP_QUERY_LIMIT=60
# 每個 IP／IPv6 /64 的失敗總數，成功登入不清除；到期才重置。
LOGIN_FAILURE_LIMIT=100
LOGIN_WINDOW_SECONDS=900
# 已知帳號＋IP／IPv6 /64 的失敗次數與視窗。
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=300
# local 與 production 都只使用單程序記憶體；重啟或管理重置後計數歸零。
LIMIT_STORE=memory
# 需求單（含狀態與簽核紀錄）保存在單一 JSON 檔，預設 data/tickets.json；含需求單原文，不提交 Git。
# 留空使用預設路徑；多個 instance 不會共用這個檔案。
TICKETS_FILE=
# 本機留空。上雲後依實際代理鏈指定 IP／網段或 hop 數，勿直接信任所有代理。
TRUST_PROXY=

# CloudFront 部署時設定，至少 32 bytes；同一秘密填入 origin custom header：X-Origin-Verify。
# 本機及第一次 EB 驗證可留空；不是前端設定，不得提交實際值。
ORIGIN_VERIFY_SECRET=
