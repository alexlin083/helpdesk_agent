# 本機 npm start／npm run dev（node src/index.js）專用；Docker Compose 改用根目錄 .env.example。
# NODE_ENV 由 shell 或部署平台設定（寫在本檔不會改變模式）；只接受 local（本機預設）或 production（正式環境，不讀本檔）。
PORT=3000
CORS_ORIGIN=http://localhost:5173
# AI 主要供應商：gemini（預設）或 anthropic；需求單判斷與「自動生成」共用。
# 另一家有填金鑰時作為備援：主要供應商回 429（額度或流量已滿）時才改用，之後 60 秒內直接用備援。
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Claude 金鑰（選填，備援用）；自動生成需要模型支援結構化輸出與工具呼叫；預設 claude-sonnet-5-5。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# debug 顯示請求參數與回應中繼資料；不輸出需求單原文或金鑰。
LOG_LEVEL=info
# 關機最多等待既有需求單處理（判斷逾時 15 秒、自動生成一回合 20 秒）與租約清理的毫秒數，至少 30000。
SHUTDOWN_TIMEOUT_MS=75000

# 必填：一般課堂帳號的共用密碼，私下提供，不要填入此範本或提交 Git。
DEMO_PASSWORD=
# 必填：應用程式管理員 alex.admin 的獨立密碼，不得與 DEMO_PASSWORD 相同；不是 AWS IAM 密碼。
ADMIN_PASSWORD=
# 本機留空時自動產生並保存在 SQLite（meta 表），重新啟動後登入仍有效；production 必填至少 32 bytes 的隨機字串。
AUTH_SECRET=
AUTH_TTL_SECONDS=7200
CHAT_COOLDOWN_SECONDS=10
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
GLOBAL_CONCURRENCY=2
# HTTP 層限制，與需求單冷卻／每日額度分開；每個 middleware 各自計數。
HTTP_RATE_WINDOW_SECONDS=60
HTTP_RATE_MAX_KEYS=2048
HTTP_API_LIMIT=300
HTTP_LOGIN_LIMIT=120
HTTP_TICKET_LIMIT=12
HTTP_DEPARTMENTS_LIMIT=30
HTTP_QUERY_LIMIT=60
# 「自動生成」對話（POST /api/tickets/draft）：每帳號 HTTP 視窗上限，手動編輯驗證也計入。
HTTP_DRAFT_LIMIT=30
# 自動生成的每日 AI 額度（以回合計：一回合可能含工具階段與整理階段的數次 AI 呼叫，只扣一次），與需求單判斷（USER_DAILY_LIMIT／GLOBAL_DAILY_LIMIT）分開計算、沒有冷卻；並行仍受 GLOBAL_CONCURRENCY 限制。
# 只有第一次開啟視窗或帶訊息時才扣額；未設選定供應商的金鑰或額度用完時請求仍成功，使用者可直接手動填寫欄位。
DRAFT_USER_DAILY_LIMIT=60
DRAFT_GLOBAL_DAILY_LIMIT=300
# 每個 IP／IPv6 /64 的失敗總數，成功登入不清除；到期才重置。
LOGIN_FAILURE_LIMIT=100
LOGIN_WINDOW_SECONDS=900
# 已知帳號＋IP／IPv6 /64 的失敗次數與視窗。
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=300
# local 與 production 都只使用單程序記憶體；重啟或管理重置後計數歸零。
LIMIT_STORE=memory
# 需求單（含狀態與簽核紀錄）與人員資料（帳號、部門、員工、假別額度）保存在 SQLite 檔，預設 storage/helpdesk.db；含需求單原文，不提交 Git。
# scripts/personnel.js 等維運腳本也使用這個路徑；人員資料沒有其他副本，調整前先以 scripts/db-backup.js 備份。
# 留空使用預設路徑；目錄必須已存在。只適用單一程序，多個 instance 不會共用這個檔案。
DATABASE_FILE=
# 留空使用預設路徑；有設定時填絕對路徑。
# 舊版 JSON 需求單檔，預設 storage/tickets.json；服務不寫入。只在資料庫第一次初始化（沒有匯入紀錄）時自動匯入；
# 之後才放入的檔案只記錄 legacy-appeared 警告，需在 backend 目錄執行 node scripts/import-legacy-tickets.js --import-late（需求單資料表為空時才匯入）。
TICKETS_FILE=
# 本機留空（不信任代理）。上雲後依實際代理鏈填信任的跳數整數、loopback／linklocal／uniquelocal 或逗號分隔的 IP／CIDR；
# 不接受 true／false，格式無效時後端拒絕啟動。勿直接信任所有代理。
TRUST_PROXY=

# 可選代理來源秘密，供歷史 CloudFront 等其他拓撲使用；至少 32 bytes。
# 目前 Docker Compose 固定停用此欄位；Docker 參數請使用根目錄 .env.example。
# 本機留空；不是前端設定，不得提交實際值。
ORIGIN_VERIFY_SECRET=
