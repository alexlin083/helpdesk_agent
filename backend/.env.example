# NODE_ENV 由 shell / AWS 平台設定；本機預設 development。
PORT=3000
CORS_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# debug 顯示快取、請求參數與回應中繼資料；不輸出問題、文件或金鑰。
LOG_LEVEL=info
# Agent 整次檢索及推理總期限；前端目前等候 100 秒，若調高需一併協調。
AGENT_TIMEOUT_MS=60000
# 至少比 Agent 總期限多 10 秒，等待配額清理後再退出。
SHUTDOWN_TIMEOUT_MS=75000

# 必填：十組課堂帳號的共用密碼，私下提供，不要填入此範本或提交 Git。
DEMO_PASSWORD=
# 本機留空時使用暫時隨機值；production 必填至少 32 bytes 的隨機字串。
AUTH_SECRET=
AUTH_TTL_SECONDS=7200
CHAT_COOLDOWN_SECONDS=10
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
GLOBAL_CONCURRENCY=2
# HTTP 層限制，與 Agent 冷卻／每日額度分開；每個 middleware 各自計數。
HTTP_RATE_WINDOW_SECONDS=60
HTTP_RATE_MAX_KEYS=2048
HTTP_API_LIMIT=300
HTTP_LOGIN_LIMIT=120
HTTP_CHAT_LIMIT=12
HTTP_USAGE_LIMIT=30
# 每個 IP／IPv6 /64 的失敗總數，成功登入不清除；到期才重置。
LOGIN_FAILURE_LIMIT=100
LOGIN_WINDOW_SECONDS=900
# 已知帳號＋IP／IPv6 /64 的失敗次數與視窗。
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=300
# 本機用 memory；production 強制要求 dynamodb 與下列 table、region。
LIMIT_STORE=memory
LIMIT_TABLE=
AWS_REGION=
# 本機留空。上雲後依實際代理鏈指定 IP／網段或 hop 數，勿直接信任所有代理。
TRUST_PROXY=
