{
  "id": "leave",
  "version": 5,
  "name": "請假申請",
  "department_id": "dept-hr-1",
  "ai": {
    "description": "員工請假：需要請假的起訖日期時間（台北時間、24 小時制）、假別（事假、病假、特休）與同部門的代理人；請假時數與剩餘時數一律由後端計算；事假與特休建議至少提早 1 個工作天提出，沒提早也可以送出，病假不受限；使用者提到不要影響手上的工作、或要你排方案時，可以查本人的待辦需求單，待辦多或有指定給本人的單時，建議請假前先處理，或在備註寫明交接給代理人；待辦是目前整體的數量、跟日期無關，不要說成某一天有或沒有待辦、某一天比較忙，要說「你目前有 N 張待辦」；使用者給了期間（例如下週、下下週、月底）但沒指定哪一天時，不要先問哪一天：查完額度、同事與待辦後，直接在 proposals 提出 1 到 3 個落在這段期間、日期不同的方案（避開假日、週末、行事曆忙碌與沒有代理人可選的日子），使用者沒說假別時依剩餘額度挑特休或事假並在 reasons 說明，代理人從 colleagues 中 available 為 true 的同事挑；suggestions 不要重複方案的日期；只有連期間都不清楚（例如只說想休息幾天）時才先問期間",
    "examples": ["2026/12/1 請假", "下週一請病假", "12/3 下午請特休"],
    "greeting": "{username} 你好，這邊已經收到你想要請假的需求，根據您的需求您的業務將會由人資部進行處理；你可以直接告訴我想達成的目標，例如「下週想請一天，不要影響手上的工作」，我會查你的假別額度、同事的請假狀況、你手上的待辦需求單，以及你已連接的行事曆與公司規章，整理 1 到 3 個方案給你挑，你選了才會填進右側；也可以直接告訴我你想請假的日期、時間、假別、代理人，我將會自動為您生成需求單給您送出；事假與特休建議至少提早 1 個工作天提出；如果填寫過程中有遇到任何問題，可以隨時與我溝通，例如不清楚填寫格式或者代理人可以選擇誰等等",
    "ask_order": ["start_at", "end_at", "leave_type", "agent"],
    "tools": ["colleagues", "my_leave_balance", "my_pending_tickets", "department_directory", "calendar_busy", "calendar_events", "policy_lookup"],
    "max_tool_calls": 5
  },
  "calendar": {
    "timezone_offset": "+08:00",
    "work_windows": [["09:00", "12:00"], ["13:00", "18:00"]],
    "workdays": [1, 2, 3, 4, 5],
    "holidays": {
      "2026": ["2026-12-25"],
      "2027": ["2027-01-01", "2027-02-04", "2027-02-05", "2027-02-08", "2027-02-09", "2027-02-10", "2027-03-01"]
    },
    "unit_minutes": 1,
    "min_minutes": 1,
    "max_days": 14,
    "same_year": true
  },
  "fields": [
    { "key": "applicant", "label": "請假人", "type": "self" },
    { "key": "leave_type", "label": "假別", "type": "enum", "options": ["事假", "病假", "特休"], "required": true },
    { "key": "start_at", "label": "請假起始時間", "type": "datetime", "required": true },
    { "key": "end_at", "label": "請假截止時間", "type": "datetime", "required": true, "rules": { "after": "start_at" } },
    {
      "key": "agent",
      "label": "代理人",
      "type": "account",
      "required": true,
      "options_tool": "colleagues",
      "filters": { "same_department": true, "not_self": true, "active": true, "not_busy_between": ["start_at", "end_at"] },
      "unavailable_message": "這位同事在此期間也有請假，不能擔任代理人",
      "unavailable_reason": "此期間已有請假"
    },
    { "key": "note", "label": "備註", "type": "text", "max_length": 200 }
  ],
  "computations": [
    {
      "key": "minutes",
      "label": "請假時數",
      "capability": "work_minutes",
      "args": { "start": "start_at", "end": "end_at", "calendar": "calendar" },
      "display": "hours_minutes",
      "messages": {
        "cross_year": "請假期間不可跨年度，請分開申請",
        "year_closed": "{year} 年度尚未開放請假",
        "max_days": "請假期間最多 {max_days} 天",
        "no_work_time": "請假期間沒有落在上班時段"
      }
    }
  ],
  "ledger": {
    "kind": "balance",
    "category_field": "leave_type",
    "amount": "minutes",
    "period_from": "start_at",
    "entitlement_table": "leave_entitlements"
  },
  "checks": [
    {
      "capability": "ledger_balance",
      "on": ["draft", "submit", "approve"],
      "error": { "code": "LEAVE_BALANCE_INSUFFICIENT", "message": "假別剩餘時數不足" },
      "summary_label": "{leave_type}剩餘時數"
    },
    {
      "capability": "ledger_overlap",
      "on": ["draft", "submit"],
      "args": { "start": "start_at", "end": "end_at" },
      "error": { "code": "LEAVE_OVERLAP", "message": "這段時間已有請假單" }
    }
  ],
  "render": {
    "lines": [
      "[請假人]: {applicant}",
      "[請假日期]: {start_at|date_range:end_at}",
      "[請假起始時間]: {start_at|time}",
      "[請假截止時間]: {end_at|time}",
      "[假別]: {leave_type}",
      "[請假時數]: {minutes|hours_minutes}",
      "[代理人]: {agent}",
      "[備註]: {note|default:無}"
    ]
  },
  "workflow": {
    "route": "FORM",
    "approver": { "department": "definition", "not_requester": true, "message": "不能簽核自己提出的請假單" },
    "transfer": false,
    "transfer_error": { "code": "FORM_TICKET_LOCKED", "message": "請假單不能轉出人資部" },
    "notify": { "target": "薪資系統", "when": { "field": "leave_type", "values": ["事假"] } }
  }
}
