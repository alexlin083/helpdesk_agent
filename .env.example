# Docker Compose 專用：複製為專案根目錄的 .env；不覆蓋 backend/.env。
# 只使用 local 與 production。Compose 會將參數注入容器，正式後端不讀磁碟 .env。
NODE_ENV=local

# 本機：瀏覽器開啟 http://localhost:8080/helpdesk/，只綁定本機。
SITE_ADDRESS=http://localhost
CORS_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443

# 必填，私下輸入兩組不同密碼；沒有內建預設密碼。
# 若值包含 $ 或 #，請以單引號包住整個值，避免 Compose 插值或截斷。
DEMO_PASSWORD=
ADMIN_PASSWORD=
# production 必填：至少 32 bytes 的隨機字串，部署更新時維持相同值。
AUTH_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=info

# 沿用既有保護；計數只存在記憶體，容器或程序重啟後歸零。
CHAT_COOLDOWN_SECONDS=10
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
GLOBAL_CONCURRENCY=2

# 正式主機改為下列設定，網域以你實際持有的名稱取代：
# NODE_ENV=production
# SITE_ADDRESS=helpdesk.example.com
# CORS_ORIGIN=https://helpdesk.example.com
# CORS_ORIGIN 只填 origin，不加入 /helpdesk；子路徑由 Caddy 與前端模組位置決定。
# HTTP_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_BIND=0.0.0.0
# HTTPS_PORT=443
