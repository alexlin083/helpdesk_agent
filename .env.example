# Docker Compose 專用：複製為專案根目錄的 .env；不覆蓋 backend/.env。
# 只使用 local 與 production。Compose 會將參數注入容器，正式後端不讀磁碟 .env。
# 若以 HELPDESK_ENV_FILE 指定其他檔案，NODE_ENV 與 CORS_ORIGIN 必須寫在那個檔案；compose.yaml 不再另外設定或提供預設值。
# PORT、DATABASE_FILE、TICKETS_FILE、LIMIT_STORE、TRUST_PROXY、ORIGIN_VERIFY_SECRET、SHUTDOWN_TIMEOUT_MS 由 compose.yaml 的 environment 固定，寫在這裡也會被覆蓋。
# NODE_ENV：local 或 production；未填時後端以 local 執行。
NODE_ENV=local

# 本機：瀏覽器開啟 http://localhost:8080/helpdesk/，只綁定本機。
SITE_ADDRESS=http://localhost
# CORS_ORIGIN：瀏覽器開啟網站的 origin（本機為 http://localhost:8080）；production 必填，未填時後端拒絕啟動；local 未填時後端預設為 http://localhost:5173。
CORS_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
HTTPS_PORT=8443

# 必填，私下輸入兩組不同密碼；沒有內建預設密碼。
# 若值包含 $ 或 #，請以單引號包住整個值，避免 Compose 插值或截斷。
DEMO_PASSWORD=
ADMIN_PASSWORD=
# production 必填：至少 32 bytes 的隨機字串，部署更新時維持相同值。
AUTH_SECRET=
# AI 主要供應商：gemini（預設）或 anthropic；production 只要求主要供應商的金鑰。需求單判斷與「自動生成」共用。
# 另一家有填金鑰時作為備援：主要供應商回 429（額度或流量已滿）時才改用。
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LOG_LEVEL=info

# 沿用既有保護；計數只存在記憶體，容器或程序重啟後歸零。
CHAT_COOLDOWN_SECONDS=10
USER_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=100
GLOBAL_CONCURRENCY=2
# 「自動生成」對話（POST /api/tickets/draft）：HTTP_DRAFT_LIMIT 為每帳號每個 HTTP 視窗（預設 60 秒）的請求數，手動編輯的驗證呼叫也計入；
# DRAFT_USER_DAILY_LIMIT／DRAFT_GLOBAL_DAILY_LIMIT 為每帳號／全站每日 AI 回合數（一回合可能含工具階段與整理階段的數次 Gemini 呼叫，只扣一次），與需求單判斷分開計算、沒有冷卻，並行仍受 GLOBAL_CONCURRENCY 限制。
# 額度用完時自動生成仍可手動填寫；計數只存在記憶體，重啟或管理重置後歸零。
HTTP_DRAFT_LIMIT=30
DRAFT_USER_DAILY_LIMIT=60
DRAFT_GLOBAL_DAILY_LIMIT=300

# 正式主機改為下列設定，網域以你實際持有的名稱取代：
# NODE_ENV=production
# SITE_ADDRESS=helpdesk.example.com
# CORS_ORIGIN=https://helpdesk.example.com
# CORS_ORIGIN 只填 origin，不加入 /helpdesk；子路徑由 Caddy 與前端模組位置決定。
# HTTP_BIND=0.0.0.0
# HTTP_PORT=80
# HTTPS_BIND=0.0.0.0
# HTTPS_PORT=443
